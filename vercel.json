{
  "outputDirectory": "docs",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/shop/:category/:product",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/internal/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "images": {
    "sizes": [
      320,
      480,
      640,
      828,
      1080,
      1440,
      1920
    ],
    "formats": [
      "image/avif",
      "image/webp"
    ],
    "minimumCacheTTL": 31536000,
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "d8j0ntlcm91z4.cloudfront.net"
      },
      {
        "protocol": "https",
        "hostname": "d2ol7oe51mr4n9.cloudfront.net"
      }
    ]
  }
}
